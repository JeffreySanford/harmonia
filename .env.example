# Environment Variables Template
# Copy this file to .env and fill in your values.

NODE_ENV=development

# MongoDB Configuration
MONGO_ROOT_PASSWORD=
MONGO_HARMONIA_PASSWORD=
MONGO_WIREDTIGER_CACHE_GB=2
MONGO_MAX_CONNS=500
# MONGODB_URI=mongodb://harmonia_app:encoded-password@127.0.0.1:27017/harmonia?authSource=harmonia

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-characters

# Redis is optional/reserved and is not provisioned by the current Compose runtime.
REDIS_HOST=localhost
REDIS_PORT=6379

PORT=3000
HOST=localhost
CORS_ORIGIN=http://localhost:4200
API_PREFIX=api

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
MAX_FILE_SIZE=52428800
UPLOAD_DEST=./uploads
LOG_LEVEL=debug

DEV_AUTOGEN_TEST_USER=false

# Local development / E2E test account.
# Never reuse these weak credentials outside local development.
E2E_TEST_USER_USERNAME=test-user
E2E_TEST_USER_EMAIL=test-user@harmonia.local
E2E_TEST_USER_PASSWORD=password

# Worker
HUGGINGFACE_HUB_TOKEN=

# Ollama is external to Docker Compose.
# When true, start:all verifies OLLAMA_URL before starting the app servers.
USE_OLLAMA=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek
