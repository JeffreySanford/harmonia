FROM ubuntu:20.04

LABEL org.opencontainers.image.title="harmonia-diffsinger"
LABEL org.opencontainers.image.description="Pinned OpenVPI DiffSinger compatibility runtime for Harmonia."

ARG DIFFSINGER_REF=017bd488a61ebdb8909a8d272ec6211076fa4a7e

ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=America/Chicago
ENV TMPDIR=/tmp
ENV TEMP=/tmp
ENV TMP=/tmp
ENV PYTHONPATH=/opt/DiffSinger
ENV HARMONIA_DIFFSINGER_REF=${DIFFSINGER_REF}
WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl unzip git build-essential cmake ffmpeg \
    python3.8 python3.8-dev python3-pip \
    libsndfile1 libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN python3.8 -m pip install --no-cache-dir \
    'pip<24' 'setuptools<60' wheel

RUN git clone https://github.com/openvpi/DiffSinger.git /opt/DiffSinger \
    && cd /opt/DiffSinger \
    && git checkout --detach "${DIFFSINGER_REF}" \
    && test "$(git rev-parse HEAD)" = "${DIFFSINGER_REF}"

# PyTorch 1.8.2 LTS is the documented runtime for this compatibility
# revision and supports Python 3.8 with CUDA 11.1.
RUN python3.8 -m pip install --no-cache-dir \
    torch==1.8.2 torchvision==0.9.2 torchaudio==0.8.2 \
    --extra-index-url https://download.pytorch.org/whl/lts/1.8/cu111

RUN python3.8 -m pip install --no-cache-dir -r /opt/DiffSinger/requirements.txt

RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.8 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.8 1

COPY entrypoint.diffsinger.sh /workspace/entrypoint.diffsinger.sh
RUN sed -i 's/\r$//' /workspace/entrypoint.diffsinger.sh \
    && chmod +x /workspace/entrypoint.diffsinger.sh

COPY scripts/*.py /workspace/scripts/
RUN chmod +x /workspace/scripts/*.py || true

ENTRYPOINT ["/workspace/entrypoint.diffsinger.sh"]
CMD ["sleep", "infinity"]
