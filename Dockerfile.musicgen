FROM ubuntu:22.04

LABEL org.opencontainers.image.title="harmonia-musicgen"
LABEL org.opencontainers.image.description="Isolated AudioCraft/MusicGen provider runtime for Harmonia."

ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=America/Chicago
ENV TMPDIR=/tmp
ENV TEMP=/tmp
ENV TMP=/tmp
ENV HF_HOME=/workspace/models/musicgen/huggingface
ENV TORCH_HOME=/workspace/models/musicgen/torch
WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    gnupg \
    curl \
    git \
    build-essential \
    ffmpeg \
    pkg-config \
    libsndfile1 \
    libavformat-dev \
    libavcodec-dev \
    libavutil-dev \
    libswscale-dev \
    libavdevice-dev \
    libavfilter-dev \
    libswresample-dev \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.9 \
    python3.9-dev \
    python3.9-distutils \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sSL https://bootstrap.pypa.io/get-pip.py | python3.9
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.9 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.9 1

RUN python3.9 -m pip install --upgrade pip setuptools wheel

# AudioCraft 1.3.0 officially targets Python 3.9 + PyTorch 2.1.0.
RUN python3.9 -m pip install \
    torch==2.1.0 \
    torchvision==0.16.0 \
    torchaudio==2.1.0

RUN python3.9 -m pip install audiocraft==1.3.0

COPY entrypoint.musicgen.sh /workspace/entrypoint.musicgen.sh
RUN sed -i 's/\r$//' /workspace/entrypoint.musicgen.sh \
    && chmod +x /workspace/entrypoint.musicgen.sh

COPY scripts/generate_musicgen_audio.py /workspace/scripts/generate_musicgen_audio.py
RUN chmod +x /workspace/scripts/generate_musicgen_audio.py

ENTRYPOINT ["/workspace/entrypoint.musicgen.sh"]
CMD ["sleep", "infinity"]
